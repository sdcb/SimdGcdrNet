<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Sdcb.SimdGcdrNet</AssemblyName>
    <RootNamespace>Sdcb.SimdGcdrNet</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <!-- LINQPad picks these up from packages tagged linqpad-samples -->
    <None Include="linqpad-samples\*.linq" Pack="true" PackagePath="linqpad-samples" />
  </ItemGroup>
  <!-- the engine, compiled in as internal types -->
  <Import Project="$(SimdOnnxRoot)src\Sdcb.SimdOnnx\Sdcb.SimdOnnx.Sources.props" />
</Project>
