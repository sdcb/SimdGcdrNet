<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Sdcb.SimdGcdrNet</AssemblyName>
    <RootNamespace>Sdcb.SimdGcdrNet</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <!-- LINQPad picks these up from packages tagged linqpad-samples -->
    <None Include="linqpad-samples\*.linq" Pack="true" PackagePath="linqpad-samples" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseLocalSimdOnnx)' == 'true'">
    <ProjectReference Include="$(SimdOnnxProject)" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseLocalSimdOnnx)' != 'true'">
    <PackageReference Include="Sdcb.SimdOnnx" Version="[$(SdcbSimdOnnxVersion)]" />
  </ItemGroup>
</Project>
